  <!-- ================= ADMIN: CATEGORY MODEL ================= -->
  <file path="admin/model/catalog/category.php">

    <!-- helper: get selected category stickers -->
    <operation>
      <search><![CDATA[class ModelCatalogCategory extends Model {]]></search>
      <add position="after"><![CDATA[
public function getCategoryStickers($category_id) {
  $sticker_data = array();

  $query = $this->db->query("
    SELECT product_sticker_id
    FROM `" . DB_PREFIX . "category_to_sticker`
    WHERE category_id = '" . (int)$category_id . "'
  ");

  foreach ($query->rows as $result) {
    $sticker_data[] = (int)$result['product_sticker_id'];
  }

  return $sticker_data;
}
    ]]></add>
    </operation>

    <!-- add category stickers -->
    <operation>
      <search><![CDATA[$category_id = $this->db->getLastId();]]></search>
      <add position="after"><![CDATA[
if (isset($data['category_sticker']) && is_array($data['category_sticker'])) {
  foreach ($data['category_sticker'] as $product_sticker_id) {
    $this->db->query("
      INSERT IGNORE INTO `" . DB_PREFIX . "category_to_sticker`
      SET category_id = '" . (int)$category_id . "',
          product_sticker_id = '" . (int)$product_sticker_id . "'
    ");
  }
}
    ]]></add>
    </operation>

    <!-- edit category stickers -->
    <operation>
      <search><![CDATA[public function editCategory($category_id, $data) {]]></search>
      <add position="after"><![CDATA[
$this->db->query("
  DELETE FROM `" . DB_PREFIX . "category_to_sticker`
  WHERE category_id = '" . (int)$category_id . "'
");

if (isset($data['category_sticker']) && is_array($data['category_sticker'])) {
  foreach ($data['category_sticker'] as $product_sticker_id) {
    $this->db->query("
      INSERT IGNORE INTO `" . DB_PREFIX . "category_to_sticker`
      SET category_id = '" . (int)$category_id . "',
          product_sticker_id = '" . (int)$product_sticker_id . "'
    ");
  }
}
    ]]></add>
    </operation>

    <!-- delete category stickers -->
    <operation>
      <search><![CDATA[public function deleteCategory($category_id) {]]></search>
      <add position="after"><![CDATA[
$this->db->query("
  DELETE FROM `" . DB_PREFIX . "category_to_sticker`
  WHERE category_id = '" . (int)$category_id . "'
");
    ]]></add>
    </operation>

    <!-- category list filter by sticker -->
    <operation>
      <search><![CDATA[$sql .= " GROUP BY cp.category_id";]]></search>
      <add position="before"><![CDATA[
if (!empty($data['filter_sticker'])) {
  $sql .= " AND cp.category_id IN (
    SELECT cts.category_id
    FROM `" . DB_PREFIX . "category_to_sticker` cts
    WHERE cts.product_sticker_id = '" . (int)$data['filter_sticker'] . "'
  )";
}
  ]]></add>
    </operation>

  </file>

  <!-- ================= ADMIN: CATEGORY FORM TEMPLATE ================= -->
  <file path="admin/view/template/catalog/category_form.twig">

    <!-- add stickers tab -->
    <operation>
      <search><![CDATA[<li><a href="#tab-seo" data-toggle="tab">{{ tab_seo }}</a></li>]]></search>
      <add position="before"><![CDATA[
<li><a href="#tab-stickers" data-toggle="tab">{{ tab_stickers }}</a></li>
    ]]></add>
    </operation>

    <!-- add stickers tab content -->
    <operation>
      <search><![CDATA[<div class="tab-pane" id="tab-seo">]]></search>
      <add position="before"><![CDATA[
<div class="tab-pane" id="tab-stickers">
  <div class="form-group">
    <label class="col-sm-2 control-label">{{ tab_stickers }}</label>
    <div class="col-sm-10">
      <div class="well well-sm" style="height:200px; overflow:auto;">
        {% if stickers %}
          {% for sticker in stickers %}
            <div class="checkbox">
              <label>
                <input type="checkbox" name="category_sticker[]" value="{{ sticker.product_sticker_id }}"
                  {% if sticker.product_sticker_id in category_sticker %}checked="checked"{% endif %} />
                {{ sticker.name }}
              </label>
            </div>
          {% endfor %}
        {% else %}
          <p class="text-muted">{{ text_stickers_none }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</div>
    ]]></add>
    </operation>

  </file>

  <!-- ================= ADMIN: CATEGORY LIST TEMPLATE ================= -->
  <file path="admin/view/template/catalog/category_list.twig">

    <operation>
      <search><![CDATA[<form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-category">]]></search>
      <add position="before"><![CDATA[
<div class="well">
  <div class="row">
    <div class="col-sm-4">
      <div class="form-group">
        <label class="control-label" for="input-filter-sticker">{{ text_filter_sticker }}</label>
        <select name="filter_sticker" id="input-filter-sticker" class="form-control">
          <option value="">{{ text_select_stickers }}</option>
          {% for sticker in filter_stickers %}
            <option value="{{ sticker.product_sticker_id }}" {% if sticker.product_sticker_id == filter_sticker %}selected="selected"{% endif %}>
              {{ sticker.name }}
            </option>
          {% endfor %}
        </select>
      </div>
    </div>

    <div class="col-sm-2">
      <div class="form-group">
        <label class="control-label">&nbsp;</label>
        <button type="button" id="button-filter-sticker" class="btn btn-primary btn-block">
          <i class="fa fa-filter"></i> {{ button_filter }}
        </button>
      </div>
    </div>
  </div>
</div>
    ]]></add>
    </operation>

    <operation>
      <search><![CDATA[{{ footer }}]]></search>
      <add position="before"><![CDATA[
<script type="text/javascript"><!--
$('#button-filter-sticker').on('click', function() {
  var url = 'index.php?route=catalog/category&user_token={{ user_token }}';

  var filter_sticker = $('select[name=\'filter_sticker\']').val();

  if (filter_sticker) {
    url += '&filter_sticker=' + encodeURIComponent(filter_sticker);
  }

  location = url;
});
//--></script>
  ]]></add>
    </operation>

  </file>

