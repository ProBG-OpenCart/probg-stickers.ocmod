{{ header }}{{ column_left }}

<div id="content">
  <div class="panel panel-default">
    <div class="panel-heading">
      <h3 class="panel-title"><i class="fa fa-tags"></i> {{ heading_title }}</h3>
    </div>
    <div class="panel-body">
      <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-product-sticker">
        <div class="form-group required">
          <div class="row">
            <label class="col-sm-2 col-md-3 control-label">{{ entry_name }}</label>
            <div class="col-sm-10 col-md-9">
              <ul class="nav nav-tabs" id="language">
                {% for language in languages %}
                  <li>
                    <a href="#language{{ language.language_id }}" data-toggle="tab">
                      <img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" /> {{ language.name }}
                    </a>
                  </li>
                {% endfor %}
              </ul>
              <div class="tab-content">
                {% for language in languages %}
                  <div class="tab-pane" id="language{{ language.language_id }}">
                    <input type="text"
                           name="product_sticker_description[{{ language.language_id }}][name]"
                           value="{{ product_sticker_description[language.language_id] is defined ? product_sticker_description[language.language_id].name : '' }}"
                           placeholder="{{ entry_name }}"
                           class="form-control" />

                    {% if error_name[language.language_id] is defined %}
                      <div class="text-danger">{{ error_name[language.language_id] }}</div>
                    {% endif %}
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>
        </div>
        <div class="form-group">
          <div class="row">
            <label class="col-sm-2 col-md-3 control-label" for="input-color">{{ entry_color }}</label>
            <div class="col-sm-6 col-md-3">
              <input id="input-color" type="color" name="color" value="{{ color }}" class="form-control" />
            </div>
          </div>
        </div>
        <div class="form-group">
          <div class="row">
            <label class="col-sm-2 col-md-3 control-label" for="input-text-color">{{ entry_text }}</label>
            <div class="col-sm-6 col-md-3">
              <input id="input-text-color" type="color" name="text_color" value="{{ text_color }}" class="form-control" />
            </div>
          </div>
        </div>
        <div class="form-group">
          <div class="row">
            <label class="col-sm-2 col-md-3 control-label" for="input-sort-order">Подредба</label>
            <div class="col-sm-6 col-md-3">
              <input type="number" name="sort_order" value="{{ sort_order }}" id="input-sort-order" class="form-control" />
            </div>
          </div>
        </div>
        <div class="form-group">
          <div class="row">
            <label class="col-sm-2 col-md-3 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-6 col-md-3">
              <select name="status" id="input-status" class="form-control">
                {% if status %}
                  <option value="1" selected>{{ text_enabled }}</option>
                  <option value="0">{{ text_disabled }}</option>
                {% else %}
                  <option value="1">{{ text_enabled }}</option>
                  <option value="0" selected>{{ text_disabled }}</option>
                {% endif %}
              </select>
            </div>
          </div>
        </div>
      </form>
    </div>
    <div class="panel-footer">
      <button form="form-product-sticker" type="submit" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
      <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
    </div>
  </div>
  <script type="text/javascript">
      $('#language a:first').tab('show');
  </script>
</div>
{{ footer }}