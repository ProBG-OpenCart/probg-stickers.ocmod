{{ header }}
{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-settings" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary">
          <i class="fa fa-save"></i>
        </button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default">
          <i class="fa fa-reply"></i>
        </a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
      <div class="alert alert-danger alert-dismissible">
        <i class="fa fa-exclamation-circle"></i> {{ error_warning }}
        <button type="button" class="close" data-dismiss="alert">&times;</button>
      </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-tags"></i> {{ heading_title }}</h3>
      </div>
      <div class="panel-body">
        <ul class="nav nav-tabs">
          <li class="active">
            <a href="#tab-stickers" data-toggle="tab">
              <i class="fa fa-tags"></i> Стикери
            </a>
          </li>
          <li>
            <a href="#tab-settings" data-toggle="tab">
              <i class="fa fa-cog"></i> Настройки
            </a>
          </li>
        </ul>
        <div class="tab-content">
          <div class="tab-pane active" id="tab-stickers">
            <div class="well well-sm">
              <a href="{{ add }}" data-toggle="tooltip" title="{{ text_add }}" class="btn btn-primary">
                <i class="fa fa-plus"></i>
              </a>
              <button type="submit" form="form-product-sticker" data-toggle="tooltip" title="{{ text_delete }}" class="btn btn-danger" onclick="return confirm('{{ text_confirm }}');">
                <i class="fa fa-trash-o"></i>
              </button>
            </div>
            <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-product-sticker">
              <div class="table-responsive">
                <table class="table table-bordered table-hover">
                  <thead>
                  <tr>
                    <td style="width:1px;" class="text-center">
                      <input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" />
                    </td>
                    <td class="text-left">{{ column_name }}</td>
                    <td class="text-left">Цвят</td>
                    <td class="text-left">Цвят на текста</td>
                    <td class="text-right">Подредба</td>
                    <td class="text-center">{{ column_status }}</td>
                    <td class="text-right">{{ column_action }}</td>
                  </tr>
                  </thead>
                  <tbody>
                  {% if stickers %}
                    {% for sticker in stickers %}
                      <tr>
                        <td class="text-center">
                          <input type="checkbox" name="selected[]" value="{{ sticker.product_sticker_id }}" />
                        </td>
                        <td class="text-left">
                          <span style="
                             display:inline-block;
                             padding:5px 10px;
                             background-color:{{ sticker.color }};
                             color:{{ sticker.text_color }};
                             border-radius:3px;
                             font-size:12px;
                             font-weight:600;
                             ">
                            {{ sticker.name }}
                          </span>
                        </td>
                        <td class="text-left">
                          <span style="display:inline-block;width:18px;height:18px;background:{{ sticker.color }};border:1px solid #ccc;vertical-align:middle;"></span>
                          {{ sticker.color }}
                        </td>
                        <td class="text-left">
                          <span style="display:inline-block;width:18px;height:18px;background:{{ sticker.text_color }};border:1px solid #ccc;vertical-align:middle;"></span>
                          {{ sticker.text_color }}
                        </td>
                        <td class="text-right">{{ sticker.sort_order }}</td>
                        <td class="text-center">
                          {% if sticker.status %}
                            <span class="label label-success">{{ text_enabled }}</span>
                          {% else %}
                            <span class="label label-danger">{{ text_disabled }}</span>
                          {% endif %}
                        </td>
                        <td class="text-right">
                          <a href="{{ sticker.edit }}" data-toggle="tooltip" title="{{ text_edit }}" class="btn btn-primary">
                            <i class="fa fa-pencil"></i>
                          </a>
                        </td>
                      </tr>
                    {% endfor %}
                  {% else %}
                    <tr>
                      <td class="text-center" colspan="7">{{ text_no_results }}</td>
                    </tr>
                  {% endif %}
                  </tbody>
                </table>
              </div>
            </form>
          </div>
          <div class="tab-pane" id="tab-settings">
            <form action="{{ save_settings }}" method="post" enctype="multipart/form-data" id="form-settings" class="form-horizontal">
              <div class="form-group">
                <label class="col-sm-2 control-label" for="input-sticker-position">
                  Позиция на стикерите
                </label>
                <div class="col-sm-10">
                  <select name="module_product_sticker_position" id="input-sticker-position" class="form-control">
                    {% for key, label in positions %}
                      <option value="{{ key }}" {% if key == module_product_sticker_position %}selected="selected"{% endif %}>
                        {{ label }}
                      </option>
                    {% endfor %}
                  </select>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
